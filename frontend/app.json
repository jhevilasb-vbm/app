{
  "expo": {
    "name": "VBM Gestão 3D",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.vbmimpressaod.ol4suw",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Adicione fotos dos seus produtos ao catálogo",
        "NSCameraUsageDescription": "Fotografe produtos para o catálogo"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.emergent.vbmimpressaod.ol4suw",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Adicione fotos dos seus produtos ao catálogo",
          "cameraPermission": "Fotografe produtos para o catálogo"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}